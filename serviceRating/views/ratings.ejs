<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ratings Analytics</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            background-color: #f4f4f4;
        }
        h1 {
            color: #333;
        }
        .chart-container {
            width: 80%;
            max-width: 800px;
            margin: auto;
        }
        canvas {
            background-color: white;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>

<h1>Top 5 Restaurants Ratings Analytics</h1>
<div class="chart-container">
    <canvas id="ratingsChart"></canvas>
</div>

<h1>Ratings Data Test</h1>
<pre><%= JSON.stringify(ratingsData, null, 2) %></pre>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    //const ratingsData = <%- JSON.stringify(ratingsData) %>; // Try using <%- to avoid escaping issues

    const labels = ratingsData.map(restaurant => restaurant.name);
    const averageRatings = ratingsData.map(restaurant => restaurant.averageRating);

    const ctx = document.getElementById('ratingsChart').getContext('2d');
    const ratingsChart = new Chart(ctx, {
        type: 'pie', // Changed to pie chart
        data: {
            labels: labels,
            datasets: [{
                label: 'Average Rating',
                data: averageRatings,
                backgroundColor: [
                    'rgba(75, 192, 192, 0.6)',
                    'rgba(153, 102, 255, 0.6)',
                    'rgba(255, 159, 64, 0.6)',
                    'rgba(255, 99, 132, 0.6)',
                    'rgba(54, 162, 235, 0.6)'
                ],
                borderColor: 'rgba(255, 255, 255, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                tooltip: {
                    callbacks: {
                        label: function(tooltipItem) {
                            return tooltipItem.label + ': ' + tooltipItem.raw.toFixed(1);
                        }
                    }
                }
            }
        }
    });
</script>

</body>
</html>